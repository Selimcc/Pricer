# Copier en .env (à la racine, à côté de docker-compose.yml)

# Clé secrète exigée pour les requêtes qui passent par le tunnel Internet.
# Mets une longue valeur aléatoire, et la même dans mobile/.env (EXPO_PUBLIC_API_KEY).
APP_API_KEY=change-moi-avec-une-longue-valeur-aleatoire

# Tunnel Cloudflare nommé (adresse fixe, ex. https://api.ton-domaine.fr) : voir DEPLOIEMENT.md
CLOUDFLARE_TUNNEL_TOKEN=

# Magasins et prix fictifs dans Paris centre. Mettre false pour un rendu réel
# (puis : docker compose exec api python -m app.jobs.purge --demo)
SEED_DEMO=true

# Zone importée depuis Open Prices chaque nuit (lat_min,lon_min,lat_max,lon_max). Défaut : Île-de-France
IMPORT_BBOX=48.12,1.44,49.24,3.56

# Prix lus sur les sites des enseignes : test personnel uniquement, jamais en version publique.
ENABLE_ONLINE_PRICES=false
ONLINE_RETAILERS=carrefour,leclerc,auchan,monoprix,franprix
