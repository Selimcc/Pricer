# À la maison (même Wi-Fi que le PC) : IPv4 du PC (ipconfig), jamais localhost
EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
# En magasin (4G) : l'adresse du tunnel, ex. https://xxx-yyy.trycloudflare.com
# EXPO_PUBLIC_API_URL=https://xxx-yyy.trycloudflare.com

# Même valeur que APP_API_KEY dans le .env à la racine
EXPO_PUBLIC_API_KEY=

# true = faire comme si on était à Paris centre (tests sans se déplacer)
EXPO_PUBLIC_DEMO_LOCATION=false
